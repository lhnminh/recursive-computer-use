OPENAI_API_KEY=sk-...

# MongoDB — where computer-use actions are logged.
# Optional: if unreachable, the harness still runs (logging is skipped).
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=recursive_computer_use

# Recommended for dashboard/app.py: a MongoDB user with the built-in read role.
# Falls back to MONGODB_URI when omitted.
MONGODB_DASHBOARD_URI=mongodb://readonly-user:password@localhost:27017
