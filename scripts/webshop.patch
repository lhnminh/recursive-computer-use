+class BM25Searcher:
+    """Drop-in for pyserini's LuceneSearcher (search/doc), built in memory.
+
+    Document text matches search_engine/convert_product_file_format.py:
+    title + description + first bullet point + options, lowercased.
+    """
+
+    def __init__(self, num_products=None):
+        from rank_bm25 import BM25Okapi
+
+        with open(DEFAULT_FILE_PATH) as f:
+            products = json.load(f)
+        if num_products:
+            products = products[:num_products]
+        self.asins, corpus = [], []
+        for p in products:
+            if not p.get('asin'):
+                continue
+            options = p.get('customization_options')
+            options = options if isinstance(options, dict) else {}
+            option_text = ', and '.join(
+                f"{name}: {', '.join(str(o.get('value', o)) if isinstance(o, dict) else str(o) for o in (vals or []))}"
+                for name, vals in options.items()
+            )
+            bullets = p.get('small_description') or ['']
+            text = ' '.join([
+                str(p.get('name') or ''),
+                str(p.get('full_description') or ''),
+                str(bullets[0] if isinstance(bullets, list) and bullets else bullets),
+                option_text,
+            ]).lower()
+            self.asins.append(p['asin'])
+            corpus.append(re.findall(r'\w+', text))
+        self.bm25 = BM25Okapi(corpus)
+
+    def search(self, query, k=10):
+        scores = self.bm25.get_scores(re.findall(r'\w+', query.lower()))
+        top = sorted(range(len(scores)), key=lambda i: -scores[i])[:k]
+        return [_Hit(self.asins[i]) for i in top]
+
+    def doc(self, docid):
+        return _Doc(docid)
 
 
